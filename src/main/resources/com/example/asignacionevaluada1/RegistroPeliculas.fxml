<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="800.0" spacing="14.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.asignacionevaluada1.RegistroPeliculasController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>

    <Label text="Registro de Películas">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <GridPane hgap="15.0" vgap="11.0">
        <Label text="Título:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtTitulo" promptText="Digite el título de la película"
                   prefWidth="400.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Director:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtDirector" promptText="Digite el nombre del director"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Género:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtGenero" promptText="Digite el género"
                   GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Año:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtAnio" promptText="Digite el año de estreno"
                   GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Duración:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="txtDuracion" promptText="Digite la duración"
                   GridPane.columnIndex="1" GridPane.rowIndex="4" />
    </GridPane>

    <HBox alignment="CENTER" spacing="12.0">
        <Button fx:id="btnGuardar" text="Guardar película" onAction="#guardarPelicula" />
        <Button fx:id="btnLimpiar" text="Limpiar campos" onAction="#limpiarCampos" />
        <Button fx:id="btnInformacion" text="Mostrar información" onAction="#mostrarInformacion" />
    </HBox>

    <Label text="Películas registradas">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>

    <TableView fx:id="tblPeliculas" onMouseClicked="#seleccionarPelicula"
               prefHeight="300.0" prefWidth="750.0">
        <columns>
            <TableColumn fx:id="colTitulo" prefWidth="170.0" text="Título" />
            <TableColumn fx:id="colDirector" prefWidth="170.0" text="Director" />
            <TableColumn fx:id="colGenero" prefWidth="140.0" text="Género" />
            <TableColumn fx:id="colAnio" prefWidth="90.0" text="Año" />
            <TableColumn fx:id="colDuracion" prefWidth="150.0" text="Duración" />
        </columns>
    </TableView>
</VBox>

